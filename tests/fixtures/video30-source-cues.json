[
  {
    "id": "cue-0-0",
    "start": 0,
    "end": 0.86,
    "text": "亲爱的观众朋友们"
  },
  {
    "id": "cue-1-860",
    "start": 0.86,
    "end": 3.08,
    "text": "一起来看看这些超实用的木工小技巧吧"
  },
  {
    "id": "cue-2-3080",
    "start": 3.08,
    "end": 5.2,
    "text": "日常做木工加装维修都能用得上"
  },
  {
    "id": "cue-3-5200",
    "start": 5.2,
    "end": 7.32,
    "text": "简单一操作零基础也能轻松上手"
  },
  {
    "id": "cue-4-7320",
    "start": 7.32,
    "end": 8.36,
    "text": "看完立马就能用"
  },
  {
    "id": "cue-5-8360",
    "start": 8.36,
    "end": 9.12,
    "text": "没有专用工具"
  },
  {
    "id": "cue-6-9120",
    "start": 9.12,
    "end": 10.74,
    "text": "怎么快速在原木上找中心点"
  },
  {
    "id": "cue-7-10740",
    "start": 10.74,
    "end": 12.2,
    "text": "把原木紧贴平整木板"
  },
  {
    "id": "cue-8-12200",
    "start": 12.2,
    "end": 13.08,
    "text": "不断转动原木"
  },
  {
    "id": "cue-9-13080",
    "start": 13.08,
    "end": 14.58,
    "text": "同时用记号笔多次画线"
  },
  {
    "id": "cue-10-14580",
    "start": 14.58,
    "end": 16.14,
    "text": "多到线条交回重合的位置"
  },
  {
    "id": "cue-11-16140",
    "start": 16.14,
    "end": 17.52,
    "text": "就是原木精准中心点"
  },
  {
    "id": "cue-12-17520",
    "start": 17.52,
    "end": 18.24,
    "text": "无需良据"
  },
  {
    "id": "cue-13-18240",
    "start": 18.24,
    "end": 19.2,
    "text": "省势又准确"
  },
  {
    "id": "cue-14-19200",
    "start": 19.2,
    "end": 20.34,
    "text": "木板表面磕碰凹陷"
  },
  {
    "id": "cue-15-20340",
    "start": 20.34,
    "end": 21.34,
    "text": "该怎么快速修复"
  },
  {
    "id": "cue-16-21340",
    "start": 21.34,
    "end": 22.64,
    "text": "往磕碰处喷上清水"
  },
  {
    "id": "cue-17-22640",
    "start": 22.64,
    "end": 23.56,
    "text": "贴上一张锡链筋"
  },
  {
    "id": "cue-18-23560",
    "start": 23.56,
    "end": 25.5,
    "text": "再次往纸巾表面喷水劲头"
  },
  {
    "id": "cue-19-25500",
    "start": 25.5,
    "end": 27.18,
    "text": "接着用电运斗隔着锡链筋"
  },
  {
    "id": "cue-20-27180",
    "start": 27.18,
    "end": 27.78,
    "text": "恒温运烫"
  },
  {
    "id": "cue-21-27780",
    "start": 27.78,
    "end": 29,
    "text": "利用水漆热胀原理"
  },
  {
    "id": "cue-22-29000",
    "start": 29,
    "end": 30.02,
    "text": "辅平木质凹陷"
  },
  {
    "id": "cue-23-30020",
    "start": 30.02,
    "end": 31,
    "text": "能去后简单打磨"
  },
  {
    "id": "cue-24-31000",
    "start": 31,
    "end": 31.58,
    "text": "抛光木板"
  },
  {
    "id": "cue-25-31580",
    "start": 31.58,
    "end": 32.54,
    "text": "就能恢复平掌"
  },
  {
    "id": "cue-26-32540",
    "start": 32.54,
    "end": 33.72,
    "text": "无痕修复超省钱"
  },
  {
    "id": "cue-27-33720",
    "start": 33.72,
    "end": 34.76,
    "text": "两块不同木板"
  },
  {
    "id": "cue-28-34760",
    "start": 34.76,
    "end": 36.28,
    "text": "如何拼接才能严肃合缝"
  },
  {
    "id": "cue-29-36280",
    "start": 36.28,
    "end": 37.78,
    "text": "将两块木板对齐贴合"
  },
  {
    "id": "cue-30-37780",
    "start": 37.78,
    "end": 38.94,
    "text": "用尺子在拼接边缘"
  },
  {
    "id": "cue-31-38940",
    "start": 38.94,
    "end": 39.8,
    "text": "画出基准线"
  },
  {
    "id": "cue-32-39800",
    "start": 39.8,
    "end": 41.58,
    "text": "在规准画出三角裁切标记"
  },
  {
    "id": "cue-33-41580",
    "start": 41.58,
    "end": 43.22,
    "text": "沿着标线精准裁切多余部分"
  },
  {
    "id": "cue-34-43220",
    "start": 43.22,
    "end": 45.02,
    "text": "拼接后咬合紧密缝隙极小"
  },
  {
    "id": "cue-35-45020",
    "start": 45.02,
    "end": 46.14,
    "text": "拼接牢固还美观"
  },
  {
    "id": "cue-36-46140",
    "start": 46.14,
    "end": 48.02,
    "text": "手动切割木板容易跑偏切不直"
  },
  {
    "id": "cue-37-48020",
    "start": 48.02,
    "end": 48.68,
    "text": "不用发愁"
  },
  {
    "id": "cue-38-48680",
    "start": 48.68,
    "end": 50.34,
    "text": "把板材和剧条组装固定"
  },
  {
    "id": "cue-39-50340",
    "start": 50.34,
    "end": 51.84,
    "text": "搭配电钻改装助力结构"
  },
  {
    "id": "cue-40-51840",
    "start": 51.84,
    "end": 53.06,
    "text": "借助电钻旋转动力"
  },
  {
    "id": "cue-41-53060",
    "start": 53.06,
    "end": 54.78,
    "text": "带动剧条匀速前后切割"
  },
  {
    "id": "cue-42-54780",
    "start": 54.78,
    "end": 56.52,
    "text": "切割稳定不偏移切面整齐"
  },
  {
    "id": "cue-43-56520",
    "start": 56.52,
    "end": 57.76,
    "text": "大幅节省手工力气"
  },
  {
    "id": "cue-44-57760",
    "start": 57.76,
    "end": 58.68,
    "text": "铺地板装台面"
  },
  {
    "id": "cue-45-58680",
    "start": 58.68,
    "end": 59.92,
    "text": "遇到墙脚转折尺寸"
  },
  {
    "id": "cue-46-59920",
    "start": 59.92,
    "end": 60.72,
    "text": "总对不上怎么办"
  },
  {
    "id": "cue-47-60720",
    "start": 60.72,
    "end": 62.44,
    "text": "用尺子贴合墙脚和木板边缘"
  },
  {
    "id": "cue-48-62440",
    "start": 62.44,
    "end": 63.14,
    "text": "分别划线"
  },
  {
    "id": "cue-49-63140",
    "start": 63.14,
    "end": 64.68,
    "text": "精准复刻墙脚转折角度"
  },
  {
    "id": "cue-50-64680",
    "start": 64.68,
    "end": 65.9,
    "text": "按标线裁切板裁"
  },
  {
    "id": "cue-51-65900",
    "start": 65.9,
    "end": 67.88,
    "text": "裁切后完美贴合墙脚拐脚"
  },
  {
    "id": "cue-52-67880",
    "start": 67.88,
    "end": 68.8,
    "text": "无需反复事才"
  },
  {
    "id": "cue-53-68800",
    "start": 68.8,
    "end": 70.22,
    "text": "疑似成形不浪费材料"
  }
]
