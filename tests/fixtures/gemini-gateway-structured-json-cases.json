[
  {
    "name": "clean_object",
    "input": "{\"translations\":{\"cue-1\":\"Hello.\"}}",
    "expectedValid": true,
    "expectedOperations": [],
    "expectedText": "{\"translations\":{\"cue-1\":\"Hello.\"}}"
  },
  {
    "name": "with_bom",
    "input": "\uFEFF{\"translations\":{\"cue-1\":\"Hello.\"}}",
    "expectedValid": true,
    "expectedOperations": ["strip-bom"],
    "expectedText": "{\"translations\":{\"cue-1\":\"Hello.\"}}"
  },
  {
    "name": "with_outer_whitespace",
    "input": "  \n  {\"translations\":{\"cue-1\":\"Hello.\"}}  \t\r\n",
    "expectedValid": true,
    "expectedOperations": [],
    "expectedText": "{\"translations\":{\"cue-1\":\"Hello.\"}}"
  },
  {
    "name": "with_json_fence",
    "input": "```json\n{\"translations\":{\"cue-1\":\"Hello.\"}}\n```",
    "expectedValid": true,
    "expectedOperations": ["unwrap-json-fence"],
    "expectedText": "{\"translations\":{\"cue-1\":\"Hello.\"}}"
  },
  {
    "name": "with_empty_fence",
    "input": "```\n{\"translations\":{\"cue-1\":\"Hello.\"}}\n```",
    "expectedValid": true,
    "expectedOperations": ["unwrap-json-fence"],
    "expectedText": "{\"translations\":{\"cue-1\":\"Hello.\"}}"
  },
  {
    "name": "with_bom_and_fence",
    "input": "\uFEFF```json\n{\"translations\":{\"cue-1\":\"Hello.\"}}\n```",
    "expectedValid": true,
    "expectedOperations": ["strip-bom", "unwrap-json-fence"],
    "expectedText": "{\"translations\":{\"cue-1\":\"Hello.\"}}"
  },
  {
    "name": "literal_backticks_in_json_string",
    "input": "{\"translations\":{\"cue-1\":\"Use ``` as literal text.\"}}",
    "expectedValid": true,
    "expectedOperations": [],
    "expectedText": "{\"translations\":{\"cue-1\":\"Use ``` as literal text.\"}}"
  },
  {
    "name": "literal_backticks_in_fenced_json_string",
    "input": "```json\n{\"translations\":{\"cue-1\":\"Use ``` as literal text.\"}}\n```",
    "expectedValid": true,
    "expectedOperations": ["unwrap-json-fence"],
    "expectedText": "{\"translations\":{\"cue-1\":\"Use ``` as literal text.\"}}"
  },
  {
    "name": "duplicate_literal_key",
    "input": "{\"translations\":{\"cue-1\":\"A\",\"cue-1\":\"B\"}}",
    "expectedValid": false,
    "expectedErrorCode": "duplicate-key"
  },
  {
    "name": "duplicate_escaped_key",
    "input": "{\"translations\":{\"cue-1\":\"A\",\"\\u0063ue-1\":\"B\"}}",
    "expectedValid": false,
    "expectedErrorCode": "duplicate-key"
  },
  {
    "name": "unpaired_high_surrogate",
    "input": "{\"translations\":{\"cue-1\":\"\\uD800\"}}",
    "expectedValid": false,
    "expectedErrorCode": "invalid-unicode"
  },
  {
    "name": "unpaired_low_surrogate",
    "input": "{\"translations\":{\"cue-1\":\"\\uDC00\"}}",
    "expectedValid": false,
    "expectedErrorCode": "invalid-unicode"
  },
  {
    "name": "prose_before_fence",
    "input": "Here is the JSON output:\n```json\n{\"translations\":{\"cue-1\":\"Hello.\"}}\n```",
    "expectedValid": false,
    "expectedErrorCode": "ambiguous-json"
  },
  {
    "name": "prose_after_fence",
    "input": "```json\n{\"translations\":{\"cue-1\":\"Hello.\"}}\n```\nHope that helps!",
    "expectedValid": false,
    "expectedErrorCode": "ambiguous-json"
  },
  {
    "name": "multiple_fences",
    "input": "```json\n{\"a\":1}\n```\n```json\n{\"b\":2}\n```",
    "expectedValid": false,
    "expectedErrorCode": "ambiguous-json"
  },
  {
    "name": "unclosed_fence",
    "input": "```json\n{\"translations\":{\"cue-1\":\"Hello.\"}}",
    "expectedValid": false,
    "expectedErrorCode": "ambiguous-json"
  },
  {
    "name": "array_root",
    "input": "[{\"translations\":{\"cue-1\":\"Hello.\"}}]",
    "expectedValid": false,
    "expectedErrorCode": "wrong-root"
  },
  {
    "name": "string_root",
    "input": "\"just a string\"",
    "expectedValid": false,
    "expectedErrorCode": "wrong-root"
  },
  {
    "name": "truncated_string",
    "input": "{\"translations\":{\"cue-1\":\"unfinished",
    "expectedValid": false,
    "expectedErrorCode": "invalid-json"
  },
  {
    "name": "trailing_comma",
    "input": "{\"translations\":{\"cue-1\":\"Hello.\"},}",
    "expectedValid": false,
    "expectedErrorCode": "invalid-json"
  },
  {
    "name": "single_quote",
    "input": "{'translations':{'cue-1':'Hello.'}}",
    "expectedValid": false,
    "expectedErrorCode": "invalid-json"
  },
  {
    "name": "multiple_objects",
    "input": "{\"a\":1}{\"b\":2}",
    "expectedValid": false,
    "expectedErrorCode": "ambiguous-json"
  }
]
