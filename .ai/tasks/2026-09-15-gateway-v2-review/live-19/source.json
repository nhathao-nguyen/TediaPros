{
  "sourceLanguage": "zh",
  "targetLocale": "vi-VN",
  "mode": "dubbing",
  "cues": [
    {
      "id": "cue-0-0",
      "sourceIndex": 0,
      "start": 0,
      "end": 1.48,
      "text": "一年只给你180万",
      "groupId": "cue-0"
    },
    {
      "id": "cue-1-1480",
      "sourceIndex": 1,
      "start": 1.48,
      "end": 3.68,
      "text": "然而陪伴你的只有孤独和无数的鱼儿",
      "groupId": "cue-1"
    },
    {
      "id": "cue-2-3680",
      "sourceIndex": 2,
      "start": 3.68,
      "end": 5.6,
      "text": "在这里任何东西只要敢丢下去",
      "groupId": "cue-2"
    },
    {
      "id": "cue-3-5600",
      "sourceIndex": 3,
      "start": 5.6,
      "end": 7.66,
      "text": "都会被巨龙的鱼群瞬间抢光",
      "groupId": "cue-3"
    },
    {
      "id": "cue-4-7660",
      "sourceIndex": 4,
      "start": 7.66,
      "end": 9.6,
      "text": "在这与世格觉得钻景平台上",
      "groupId": "cue-4"
    },
    {
      "id": "cue-5-9600",
      "sourceIndex": 5,
      "start": 9.6,
      "end": 11.08,
      "text": "钓鱼将是你唯一的乐趣",
      "groupId": "cue-5"
    },
    {
      "id": "cue-6-11080",
      "sourceIndex": 6,
      "start": 11.08,
      "end": 13.86,
      "text": "或者是能和同事们一起扔着烂白菜看鱼儿发呆",
      "groupId": "cue-6"
    },
    {
      "id": "cue-7-13860",
      "sourceIndex": 7,
      "start": 13.86,
      "end": 14.94,
      "text": "特别是到了晚上",
      "groupId": "cue-7"
    },
    {
      "id": "cue-8-14940",
      "sourceIndex": 8,
      "start": 14.94,
      "end": 16.44,
      "text": "无尽的寂寞包裹着你",
      "groupId": "cue-8"
    },
    {
      "id": "cue-9-16440",
      "sourceIndex": 9,
      "start": 16.44,
      "end": 18.88,
      "text": "就连扔出去的苹果都被黑暗瞬间吞没",
      "groupId": "cue-9"
    },
    {
      "id": "cue-10-18880",
      "sourceIndex": 10,
      "start": 18.88,
      "end": 19.98,
      "text": "孤独感预加强烈",
      "groupId": "cue-10"
    },
    {
      "id": "cue-11-19980",
      "sourceIndex": 11,
      "start": 19.98,
      "end": 21.66,
      "text": "好歹伙是每天四顿供应",
      "groupId": "cue-11"
    },
    {
      "id": "cue-12-21660",
      "sourceIndex": 12,
      "start": 21.66,
      "end": 22.94,
      "text": "健身娱乐样要集权",
      "groupId": "cue-12"
    },
    {
      "id": "cue-13-22940",
      "sourceIndex": 13,
      "start": 22.94,
      "end": 24.78,
      "text": "还有网吧游戏和迷你小酒吧",
      "groupId": "cue-13"
    },
    {
      "id": "cue-14-24780",
      "sourceIndex": 14,
      "start": 24.78,
      "end": 26.74,
      "text": "而一个月才来一次的直升飞机",
      "groupId": "cue-14"
    },
    {
      "id": "cue-15-26740",
      "sourceIndex": 15,
      "start": 26.74,
      "end": 28.26,
      "text": "结局按上指休息四天",
      "groupId": "cue-15"
    },
    {
      "id": "cue-16-28260",
      "sourceIndex": 16,
      "start": 28.26,
      "end": 29.48,
      "text": "很多人都坚持不了",
      "groupId": "cue-16"
    },
    {
      "id": "cue-17-29480",
      "sourceIndex": 17,
      "start": 29.48,
      "end": 31.5,
      "text": "也只有每个月准时到账的十来万",
      "groupId": "cue-17"
    },
    {
      "id": "cue-18-31500",
      "sourceIndex": 18,
      "start": 31.5,
      "end": 32.76,
      "text": "才会稍微开心一点",
      "groupId": "cue-18"
    }
  ],
  "contextBefore": [],
  "contextAfter": [],
  "glossary": []
}